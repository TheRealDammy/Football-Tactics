.root {
    flex-grow: 1;

    background-color: rgb(13, 14, 18);

    padding-left: 28px;
    padding-right: 28px;
    padding-top: 24px;
    padding-bottom: 24px;

    color: rgb(235, 237, 242);
}

.header {
    flex-direction: row;

    justify-content: space-between;
    align-items: center;

    height: 60px;

    margin-bottom: 15px;
}

.title {
    font-size: 28px;

    color: rgb(245, 246, 249);

    -unity-font-style: bold;
}

.formation-summary {
    font-size: 16px;

    color: rgb(160, 165, 178);

    -unity-font-style: bold;
}

.toolbar {
    flex-direction: row;

    align-items: center;

    height: 48px;

    margin-bottom: 14px;

    padding-left: 14px;
    padding-right: 14px;

    background-color: rgb(23, 25, 31);

    border-width: 1px;
    border-color: rgb(49, 52, 61);
}

.toolbar-label {
    margin-right: 12px;

    font-size: 11px;

    color: rgb(145, 150, 163);

    -unity-font-style: bold;
}

.formation-dropdown {
    width: 150px;
    height: 32px;
}


/* =========================================================
   MAIN
   ========================================================= */

.main {
    flex-grow: 1;

    min-height: 0;

    flex-direction: row;
}

.lineup-container {
    flex-grow: 1;

    min-width: 0;
    min-height: 0;

    padding: 20px;

    background-color: rgb(22, 24, 30);

    border-width: 1px;
    border-color: rgb(48, 51, 60);
}

.player-panel {
    width: 330px;

    min-width: 330px;

    margin-left: 15px;

    padding: 18px;

    background-color: rgb(22, 24, 30);

    border-width: 1px;
    border-color: rgb(48, 51, 60);
}


/* =========================================================
   LINEUP BUTTONS
   ========================================================= */

.lineup-slot {
    width: 135px;

    min-height: 58px;

    margin-bottom: 8px;

    background-color: rgb(42, 45, 54);

    border-width: 1px;
    border-color: rgb(69, 73, 84);

    color: rgb(235, 237, 242);

    font-size: 11px;

    -unity-font-style: bold;
}

.lineup-slot:hover {
    background-color: rgb(57, 61, 72);
}


/* =========================================================
   PLAYER LIST
   ========================================================= */

.section-title {
    margin-bottom: 14px;

    font-size: 17px;

    color: rgb(242, 244, 247);

    -unity-font-style: bold;
}

.player-list-container {
    flex-grow: 1;

    min-height: 0;
}

.player-selection-button {
    width: 100%;

    height: 50px;
    min-height: 50px;

    margin-bottom: 6px;

    background-color: rgb(40, 43, 51);

    border-width: 1px;
    border-color: rgb(61, 65, 76);

    color: rgb(230, 233, 238);

    font-size: 11px;

    -unity-font-style: bold;
}

.player-selection-button:hover {
    background-color: rgb(57, 61, 72);
}

.player-list-placeholder {
    font-size: 13px;

    color: rgb(145, 150, 163);
}


/* =========================================================
   FOOTER
   ========================================================= */

.footer {
    flex-shrink: 0;

    align-items: flex-end;

    height: 55px;

    margin-top: 15px;
}

.start-button {
    width: 190px;

    height: 42px;

    background-color: rgb(49, 54, 66);

    border-width: 1px;
    border-color: rgb(77, 82, 96);

    color: rgb(242, 244, 247);

    font-size: 12px;

    -unity-font-style: bold;
}

.start-button:hover {
    background-color: rgb(63, 68, 81);
}