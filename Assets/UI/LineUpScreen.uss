.root {
    flex-grow: 1;

    background-color: rgb(12, 14, 18);

    padding-left: 24px;
    padding-right: 24px;
    padding-top: 18px;
    padding-bottom: 18px;

    color: rgb(235, 237, 242);
}


/* =========================================================
   HEADER
   ========================================================= */

.header {
    flex-shrink: 0;

    height: 68px;

    flex-direction: row;
    justify-content: space-between;
    align-items: center;

    margin-bottom: 12px;

    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 48, 57);
}

.title {
    font-size: 23px;

    color: rgb(246, 247, 250);

    -unity-font-style: bold;
}

.club-name {
    margin-top: 2px;

    font-size: 12px;

    color: rgb(145, 150, 162);
}

.formation-control {
    flex-direction: row;
    align-items: center;
}

.formation-label {
    margin-right: 10px;

    font-size: 13px;

    color: rgb(160, 165, 178);

    -unity-font-style: bold;
}

.formation-dropdown {
    width: 140px;
    height: 32px;
}


/* =========================================================
   MAIN
   ========================================================= */

.main {
    flex-grow: 1;

    min-width: 0;
    min-height: 0;

    flex-direction: row;
}


/* =========================================================
   PITCH
   ========================================================= */

.pitch {
    width: 62%;

    min-width: 0;
    min-height: 0;

    margin-right: 12px;

    max-height: 560px;

    padding: 12px;

    background-color: rgb(25, 66, 45);

    border-width: 1px;
    border-color: rgb(71, 112, 87);
}

.pitch::after {
    content: "";

    position: absolute;

    left: 8%;
    right: 8%;
    top: 8%;
    bottom: 8%;

    border-width: 1px;
    border-color: rgba(220, 235, 225, 0.25);
}

.pitch::before {
    content: "";

    position: absolute;

    left: 50%;
    top: 8%;
    bottom: 8%;

    width: 1px;

    background-color: rgba(220, 235, 225, 0.20);
}

.lineup-container {
    position: relative;

    flex-grow: 1;

    min-width: 0;
    min-height: 0;
}


/* =========================================================
   PLAYER PANEL
   ========================================================= */

.player-panel {
    width: 38%;

    min-width: 0;
    min-height: 0;

    padding: 16px;

    background-color: rgb(22, 24, 30);

    border-width: 1px;
    border-color: rgb(48, 51, 60);
}

.section-title {
    font-size: 17px;

    color: rgb(243, 245, 248);

    -unity-font-style: bold;
}

.panel-subtitle {
    margin-top: 4px;
    margin-bottom: 12px;

    font-size: 11px;

    color: rgb(145, 150, 163);
}

.player-list-container {
    flex-grow: 1;

    min-height: 0;
}


/* =========================================================
   PITCH PLAYER BUTTONS
   ========================================================= */

.lineup-slot {
    position: absolute;

    width: 108px;
    height: 62px;

    min-width: 108px;
    min-height: 62px;

    margin: 0;

    transform-origin: center;

    background-color: rgb(31, 52, 68);

    border-width: 1px;
    border-color: rgb(92, 113, 135);

    color: rgb(242, 244, 247);

    font-size: 10px;

    -unity-font-style: bold;
}

.lineup-slot:hover {
    background-color: rgb(44, 68, 87);

    border-color: rgb(120, 140, 160);
}

.lineup-slot:active {
    background-color: rgb(57, 82, 103);
}


/* =========================================================
   PLAYER SELECTION
   ========================================================= */

.player-selection-button {
    width: 100%;

    height: 48px;
    min-height: 48px;

    margin-bottom: 6px;

    background-color: rgb(40, 43, 51);

    border-width: 1px;
    border-color: rgb(61, 65, 76);

    color: rgb(232, 234, 239);

    font-size: 11px;

    -unity-font-style: bold;
}

.player-selection-button:hover {
    background-color: rgb(55, 59, 70);
}

.selected-lineup-player {
    background-color: rgb(55, 76, 96);

    border-width: 2px;
    border-color: rgb(125, 153, 178);
}

.selected-player-heading {
    margin-bottom: 18px;

    font-size: 18px;

    color: rgb(242, 244, 247);

    -unity-font-style: bold;
}

.replacement-heading {
    margin-bottom: 8px;

    font-size: 10px;

    color: rgb(140, 145, 158);

    -unity-font-style: bold;
}


/* =========================================================
   BENCH
   ========================================================= */

.bench-section {
    flex-shrink: 0;

    height: 90px;
    min-height: 90px;

    margin-top: 10px;

    padding-left: 12px;
    padding-right: 12px;
    padding-top: 4px;
    padding-bottom: 4px;

    background-color: rgb(22, 24, 30);

    border-width: 1px;
    border-color: rgb(48, 51, 60);
}

.bench-header {
    flex-direction: row;
    align-items: center;

    height: 16px;

    margin-bottom: 6px;
}

.bench-title {
    font-size: 11px;

    padding-top: 2px;
    padding-bottom: 6px;

    color: rgb(230, 232, 237);

    -unity-font-style: bold;
}

.bench-count {
    margin-left: 8px;

    padding-top: 2px;
    padding-bottom: 6px;

    font-size: 10px;

    color: rgb(130, 135, 148);
}

.bench-container {
    width: 100%;

    height: 48px;
    min-height: 48px;

    flex-direction: row;

    overflow: hidden;
}

.bench-container .bench-player {
    flex-shrink: 1;
}

.bench-section {
    border-top-width: 2px;
    border-top-color: rgb(69, 74, 86);
}

.bench-player {
    width: 155px;
    min-width: 155px;
    max-width: 155px;

    height: 44px;
    min-height: 44px;

    margin-left: 0;
    margin-right: 6px;
    margin-top: 0;
    margin-bottom: 0;

    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;

    background-color: rgb(38, 41, 49);

    border-width: 1px;
    border-color: rgb(59, 63, 73);

    color: rgb(224, 227, 233);

    font-size: 9px;

    -unity-font-style: bold;
}

.bench-player:last-child {
    margin-right: 0;
}

.bench-player:last-child {
    margin-right: 0;
}

.bench-player:hover {
    background-color: rgb(53, 57, 67);

    border-color: rgb(80, 85, 99);
}

.selected-bench-player {
    background-color: rgb(55, 76, 96);

    border-width: 2px;
    border-color: rgb(125, 153, 178);
}

.eligible-bench-player {
    border-color: rgb(92, 116, 92);
}


/* =========================================================
   FOOTER
   ========================================================= */

.footer {
    flex-shrink: 0;

    height: 48px;

    margin-top: 10px;

    flex-direction: row;

    justify-content: flex-end;
    align-items: center;
}

.start-button {
    width: 170px;

    height: 40px;

    background-color: rgb(50, 56, 70);

    border-width: 1px;
    border-color: rgb(76, 82, 98);

    color: rgb(242, 244, 247);

    font-size: 11px;

    -unity-font-style: bold;
}

.start-button:hover {
    background-color: rgb(64, 70, 85);
}

.reset-button {
    width: 120px;

    height: 40px;

    margin-right: 8px;

    background-color: rgb(35, 38, 46);

    border-width: 1px;
    border-color: rgb(61, 65, 76);

    color: rgb(205, 208, 216);

    font-size: 11px;

    -unity-font-style: bold;
}

.reset-button:hover {
    background-color: rgb(48, 52, 62);
}